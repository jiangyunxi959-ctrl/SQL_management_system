# PostgreSQL 管理连接（用于建库/删库）
PGADMIN_HOST=127.0.0.1
PGADMIN_PORT=5432
PGADMIN_USER=postgres
PGADMIN_PASSWORD=change_me

# 项目数据库
PGDATABASE=zhishi
PGHOST=127.0.0.1
PGPORT=5432

# 本地开发角色密码（不要提交真实密码）
ETL_WRITER_PASSWORD=change_me
APP_USER_PASSWORD=change_me
AGENT_READER_PASSWORD=change_me
AUDITOR_PASSWORD=change_me
AUDIT_WRITER_PASSWORD=change_me
AUTH_LOGIN_PASSWORD=change_me

# DeepSeek 只在服务端配置。不要把真实密钥写进仓库。
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_MAX_MODEL_CALLS=6
AGENT_MAX_TOOL_CALLS=12
AGENT_DEADLINE_SECONDS=90
# Generated by app.setup_ai; do not commit a real password.
CHECKPOINT_WRITER_PASSWORD=
